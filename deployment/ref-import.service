[Unit]
Description=Network Rail Reference Data Import Service
Documentation=https://github.com/tombanbury-cyber/nrod-railhub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=railhub
Group=railhub
WorkingDirectory=/opt/nrod-railhub

# Network Rail credentials (required)
Environment="NR_USERNAME=your.email@example.com"
Environment="NR_PASSWORD=yourpassword"

# Database and storage paths
Environment="DB_PATH=/var/lib/nrod-railhub/nrod_ref.sqlite"
Environment="OUTDIR=/var/lib/nrod-railhub/ref_downloads"

# Import interval in seconds (default: 86400 = 24 hours)
# Set to lower values for testing (e.g., 300 = 5 minutes)
Environment="REF_IMPORT_INTERVAL=86400"

# Datasets to import (default: CORPUS,SMART)
Environment="DATASETS=CORPUS,SMART"

# Execute the service
# Note: Update path to use venv if you installed with virtual environment
ExecStart=/usr/bin/python3 -m nrod_railhub.services.ref_import_service
# Or with venv: ExecStart=/opt/nrod-railhub/venv/bin/python3 -m nrod_railhub.services.ref_import_service

# Restart policy
Restart=on-failure
RestartSec=60

# Security hardening (optional)
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nrod-ref-import

[Install]
WantedBy=multi-user.target
